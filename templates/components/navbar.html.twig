<a href="#main-content" class="btn btn-neutral fixed left-4 top-4 z-50 -translate-y-24 focus:translate-y-0">Aller au contenu</a>
<header class="border-b border-base-300 bg-base-100">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-5 py-5 sm:px-8">
        <a href="{{ path('app_books') }}" class="text-xl font-semibold tracking-tight">Bibliothèque<span
                class="text-base-content/40">.</span></a>
        {% set current_route = app.request.attributes.get('_route') %}
        <nav aria-label="Navigation principale" class="flex flex-wrap gap-1">
            {% for item in [{label: 'Livres', route: 'app_books', detail: 'app_book'}, {label: 'Catégories', route:
            'app_categories', detail: 'app_category'}, {label: 'Utilisateurs', route: 'app_users', detail: 'app_user'}]
            %}
            {% set active = current_route in [item.route, item.detail] %}
            <a href="{{ path(item.route) }}" class="btn btn-sm {{ active ? 'btn-neutral' : 'btn-ghost' }}" {% if active
                %} aria-current="page" {% endif %}>{{ item.label }}</a>
            {% endfor %}
        </nav>
    </div>
</header>