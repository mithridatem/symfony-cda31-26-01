{# templates/components/Toast.html.twig #}
{% set variants = {
    notice: {label: 'Information', classes: 'border-sky-600 bg-sky-50 text-sky-950', role: 'status'},
    warning: {label: 'Attention', classes: 'border-amber-600 bg-amber-50 text-amber-950', role: 'status'},
    danger: {label: 'Erreur', classes: 'border-red-600 bg-red-50 text-red-950', role: 'alert'},
    success: {label: 'Succès', classes: 'border-emerald-600 bg-emerald-50 text-emerald-950', role: 'status'},
} %}

{% for type, messages in app.flashes(variants|keys) %}
    {% set variant = variants[type] %}
    {% for message in messages %}
        <div class="mt-3 rounded-md border-s-4 px-4 py-3 text-sm {{ variant.classes }}" role="{{ variant.role }}">
            <p class="font-semibold">{{ variant.label }}</p>
            <p>{{ message }}</p>
        </div>
    {% endfor %}
{% endfor %}
