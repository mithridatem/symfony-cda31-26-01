{% extends 'base.html.twig' %}
{% form_theme form.categories 'form_div_layout.html.twig' %}

{% block title %}Ajouter un livre{% endblock %}
{% block body %}
<h1>Ajouter un Livre</h1>
{{ form_start(form) }}
{{ form_label(form.title) }}
<div>{{ form_widget(form.title) }}</div>
{{ form_errors(form.title) }}
{{ form_label(form.resume) }}
<div>{{ form_widget(form.resume) }}</div>
{{ form_errors(form.resume) }}
{{ form_label(form.author) }}
<div>{{ form_widget(form.author) }}</div>
{{ form_errors(form.author) }}
{{ form_label(form.publishAt) }}
<div>{{ form_widget(form.publishAt) }}</div>
{{ form_errors(form.publishAt) }}
{{ form_row(form.categories, {
    label: 'Catégories',
    label_attr: {class: 'font-medium'},
    row_attr: {class: 'mt-4 grid max-w-md gap-2'},
    attr: {
        size: 4,
        class: 'block w-full appearance-auto rounded-md border border-base-content/20 bg-base-100 p-2 text-base-content focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary'
    }
}) }}
{{ form_errors(form.categories) }}
{{ form_rest(form) }}
{{ form_end(form) }}
<twig:Toast/>
{% endblock %}
