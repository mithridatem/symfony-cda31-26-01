{% extends 'base.html.twig' %}

{% block title %}Météo d'une ville{% endblock %}

{% block body %}
<turbo-frame id="result">
    <h1>Chercher la météo d'une ville</h1>
    {{ form(form) }}
    {% if weather  %}
        {% if weather.cod is defined and weather.cod == 200 %}
        <p>{{ weather.name }}</p>
        <p>{{ weather.main.temp }}</p>
        <p>{{ weather.weather[0].main }}</p>
        <img src="https://openweathermap.org/img/wn/{{weather.weather[0].icon}}.png" alt="">
        {% else %}
        <p>La ville n'existe pas</p>
        {% endif %}
    {% endif %}
</turbo-frame>
{% endblock %}