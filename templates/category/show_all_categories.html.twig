{% extends 'base.html.twig' %}
{% block title %}Les catégories · Bibliothèque{% endblock %}
{% block body %}
<section aria-labelledby="page-title">
    <header class="mb-8 flex flex-wrap items-end justify-between gap-4">
        <div><p class="mb-2 text-sm font-medium uppercase tracking-widest text-base-content/50">Bibliothèque</p><h1 id="page-title" class="text-3xl font-semibold tracking-tight sm:text-4xl">Les catégories</h1><p class="mt-3 text-base-content/60">Explorez les différents univers de la bibliothèque.</p></div>
        <span class="badge badge-outline">{{ categories|length }} résultat(s)</span>
    </header>
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {% for categorie in categories %}
        <twig:InfoCard
            :objet="categorie"
            title="Category"
        />
        {% else %}
            <div class="col-span-full rounded-box border border-dashed border-base-300 bg-base-100 p-10 text-center"><h2 class="text-lg font-medium">La liste est vide</h2><p class="mt-2 text-base-content/60">Les catégories apparaîtront ici.</p></div>
        {% endfor %}
    </div>
</section>
{% endblock %}
