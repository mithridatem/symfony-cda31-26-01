{% extends "base.html.twig" %}
{% block title %}
Liste des categories
{% endblock %}
{% block body %}
<section>
    {% if categories %}
    <h1>Liste des categories</h1>
        {# boucler sur la liste des categories #}
        {% for category in categories %}
            <article>
                <h2>{{ category.name }}</h2>
                <a href="{{ path('app_category', {id: category.id }) }}">Détail</a>
            </article>
        {% endfor %}
    {% else %}
    <h2>La liste est vide</h2>
    {% endif %}
</section>  
{% endblock %}
